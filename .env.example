# BedLink Environment Configuration Example
# Copy this file to .env.local and configure in Vercel Project Settings > Environment Variables

# Next.js App Router
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Required to sign the fallback PIN session cookie (use a long random value in production)
BEDLINK_PIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional Supabase demo-user synchronization password (never expose client-side)
DEMO_AUTH_PASSWORD=replace-with-a-unique-password

# Set true only for controlled demonstrations; keep false/unset in production
ENABLE_DEMO_AUTH=false

# Google Maps JavaScript API (Client-side coordination map)
# Restrict this key in Google Cloud by HTTP referrer and Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
